# ─────────────────────────────────────────────
#  Faris Management – Environment Variables
# ─────────────────────────────────────────────
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to git.

# Vercel Postgres (auto-populated when you add Vercel Postgres in the dashboard)
POSTGRES_URL="postgresql://user:password@host:5432/farismanagement?sslmode=require"
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/farismanagement?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/farismanagement?sslmode=require"

# App
NEXT_PUBLIC_SITE_URL="https://farismanagement.com"

# Future Auth (NextAuth.js – uncomment when ready)
# NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# NEXTAUTH_URL="https://farismanagement.com"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
